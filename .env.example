# Firebase project values for sync. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way. Every build command that needs
# sync passes this file in:
#
#   flutter build apk     --release --split-per-abi --dart-define-from-file=../.env
#   flutter build windows --release                 --dart-define-from-file=../.env
#   flutter build web     --release                 --dart-define-from-file=../.env
#   flutter run -d windows                          --dart-define-from-file=../.env
#
# (paths are relative to app/, which is where those commands run)
#
# Build without it and sync reports itself switched off — the app still works,
# entirely on the one device. Nothing crashes, nothing is lost.
#
# Where to get these: Firebase console -> Project settings -> General.
# Full walkthrough in SYNC-SETUP.md.

# Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=your-project-id

# Project settings -> General -> Your apps -> web app -> apiKey
FIREBASE_API_KEY=your-web-api-key

# Firestore database ID. `(default)` unless you deliberately named it something
# else when creating the database.
FIREBASE_DATABASE_ID=(default)

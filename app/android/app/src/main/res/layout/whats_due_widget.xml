<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget: today's plan, at a glance.

  Deliberately plain. A widget is rendered by the launcher through RemoteViews,
  which supports only a fixed set of views and no custom fonts, so the app's
  Inter/Plex Mono pairing cannot cross over. Rather than approximate it badly
  this leans on the two things that do carry: the paper/ink palette and the
  mono-for-data convention, using the platform monospace family.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/whats_due_widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/wd_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:fontFamily="monospace"
        android:textColor="@color/wd_muted" />

    <TextView
        android:id="@+id/wd_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/wd_ink" />

    <!-- Three fixed rows, shown or hidden by the provider. RemoteViews has no
         way to inflate a list without a collection service, and three lines is
         all a 4x2 widget can show legibly anyway. -->
    <LinearLayout
        android:id="@+id/wd_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/wd_t0_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/wd_ink" />
        <TextView
            android:id="@+id/wd_t0_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/wd_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wd_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/wd_t1_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/wd_ink" />
        <TextView
            android:id="@+id/wd_t1_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/wd_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wd_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/wd_t2_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/wd_ink" />
        <TextView
            android:id="@+id/wd_t2_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/wd_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/wd_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace"
        android:textColor="@color/wd_muted" />
</LinearLayout>

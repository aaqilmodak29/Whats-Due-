<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget: everything due in the next week.

  Each row mirrors an Assignments card rather than inventing its own shape:
  urgency spine, subject, countdown, title, task fraction. A launcher renders
  this through RemoteViews, which supports a fixed set of views and no custom
  fonts, so the Inter/Plex Mono pairing cannot cross over. What does carry is
  the palette, the mono-for-data convention via the platform monospace family,
  and the urgency colour on the left edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/whats_due_widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/wd_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="DUE THIS WEEK"
        android:textSize="9sp"
        android:letterSpacing="0.14"
        android:fontFamily="monospace"
        android:textColor="@color/wd_muted" />

    <!-- Shown only when the week is clear; the rows are hidden in that case. -->
    <TextView
        android:id="@+id/wd_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/wd_muted" />

    <LinearLayout
        android:id="@+id/wd_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal">
        <!-- The urgency spine, painted from the payload. Same channel, same
             colours and same 6dp width as the card in the Assignments list. -->
        <View
            android:id="@+id/wd_t0_spine"
            android:layout_width="6dp"
            android:layout_height="match_parent" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/wd_card"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/wd_t0_subject"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="monospace"
                    android:textColor="@color/wd_muted" />
                <TextView
                    android:id="@+id/wd_t0_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/wd_ink" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/wd_t0_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/wd_ink" />
                <TextView
                    android:id="@+id/wd_t0_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/wd_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout

<?xml version="1.0" encoding="utf-8"?>
<!-- The widget follows the system's dark mode, not the app's own toggle: the
     launcher draws it, and it should sit against the home screen rather than
     against whatever the app was last set to.

     The spine colours arrive from Dart resolved against the light palette and
     read acceptably on either ground, so they are not duplicated here. -->
<resources>
    <color name="wd_ink">#FFE6ECF2</color>
    <color name="wd_paper">#FF0E1622</color>
    <color name="wd_card">#FF16202E</color>
    <color name="wd_muted">#FF8A99AB</color>
    <color name="wd_mark">#FFDCEE3A</color>
</resources>

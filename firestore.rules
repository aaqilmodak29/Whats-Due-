// Firestore security rules for "What's due".
//
// Paste these into Firebase console -> Firestore Database -> Rules -> Publish.
//
// This is the only thing protecting the data. The web API key committed in
// app/lib/sync/firebase_config.dart is a public project identifier, not a
// credential — it is embedded in the JavaScript of every Firebase web app.
// Access control lives here and nowhere else.
//
// The rule is deliberately narrow: a signed-in user may read and write exactly
// one document, their own, and nothing else in the database is reachable at all.
// In particular there is no `list` permission anywhere, so no one can enumerate
// which accounts exist.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}/state/current — the single document holding one account's
    // whole state as a JSON string.
    match /users/{uid}/state/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Everything else is denied. Firestore denies by default, but saying it
    // explicitly means a future rule added above cannot widen access by
    // accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
